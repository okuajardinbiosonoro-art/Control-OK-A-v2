/*
 * Control OKUA v2 - Design System CKv2
 *
 * Tokens visuales base (referencia):
 * - app bg: #F7F4EC
 * - surface 1: #FFFEFC
 * - surface 2: #FFFDFC
 * - border default: #DCCFB8
 * - border subtle: #E1D5C2
 * - text primary: #0B3B27
 * - text secondary: #5B6F66
 * - action primary: #2FAC66
 * - action danger: #C45245
 *
 * Semantica estado nodo:
 * - online: #2FAC66
 * - calibrating: #2F7ED8
 * - degraded: #DD8A12
 * - offline: #C45245
 */

QMainWindow,
QDialog {
    background-color: #F7F4EC;
}

QWidget {
    background-color: transparent;
    color: #0B3B27;
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
}

QWidget#shellContentHost,
QWidget#homeOperationContent,
QDialog#sessionDetailsDialog,
QDialog#advancedToolsDialog,
QDialog#firmwareManagerDialog,
QDialog#profileSelectorDialog,
QWidget#sessionDetailsTab,
QWidget#sessionDetailsContent,
QWidget#sessionDetailsViewport {
    background-color: #F7F4EC;
}

QToolTip {
    background-color: #FFFDF9;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    border-radius: 8px;
    padding: 6px 8px;
}

QLabel {
    background-color: transparent;
    color: #0B3B27;
    padding: 0;
}

QLabel#shellTitleLabel {
    color: #0B3B27;
    font-weight: 700;
}

QLabel#shellSubtitleLabel {
    color: #5B6F66;
}

QLabel#sectionTitleLabel {
    color: #0B3B27;
    font-size: 13pt;
    font-weight: 700;
}

QLabel#sectionHintLabel,
QLabel#dialogSubtleLabel {
    color: #5B6F66;
}

QLabel#dialogHeadlineLabel {
    color: #0B3B27;
    font-size: 15px;
    font-weight: 700;
}

QLabel#homeStatusChip {
    background-color: #E9F5EE;
    color: #0B3B27;
    border: 1px solid #C9DCCF;
    border-radius: 16px;
    padding: 7px 14px;
    font-weight: 700;
}

QLabel#homeStatusLine {
    color: #0B3B27;
    font-size: 16px;
    font-weight: 600;
}

QLabel#homeMetaLabel {
    color: #5A695F;
}

QLabel[statusTone="online"] {
    color: #248B52;
}

QLabel[statusTone="calibrating"] {
    color: #1D67B8;
}

QLabel[statusTone="degraded"] {
    color: #B06A07;
}

QLabel[statusTone="offline"] {
    color: #A33E35;
}

QGroupBox {
    background-color: #FFFEFC;
    border: 1px solid #DDD2BE;
    border-radius: 16px;
    margin-top: 18px;
    padding: 18px 14px 14px 14px;
}

QGroupBox[sectionRole="summary"] {
    background-color: #FFFEFC;
}

QGroupBox[sectionRole="actions"] {
    background-color: #FCFAF4;
}

QGroupBox[sectionRole="technical"] {
    background-color: #FFFDFC;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 14px;
    padding: 2px 10px;
    color: #0B3B27;
    background-color: #F6EFE1;
    border: 1px solid #E1D5C2;
    border-radius: 9px;
    font-weight: 700;
}

QPushButton,
QToolButton {
    background-color: #FFFDF9;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    border-radius: 12px;
    padding: 9px 14px;
    min-height: 20px;
    font-weight: 600;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #F3EBDD;
    border-color: #CBBBA0;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #E8DDCB;
    border-color: #BFA883;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #E7E5DF;
    color: #95A39B;
    border-color: #D8D4CA;
}

QPushButton:focus,
QToolButton:focus,
QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus,
QTextEdit:focus,
QPlainTextEdit:focus,
QTreeWidget:focus,
QTableWidget:focus,
QTableView:focus {
    border: 2px solid #2FAC66;
}

QPushButton[role="primary"],
QToolButton[role="primary"],
QPushButton#primarySessionButton {
    background-color: #2FAC66;
    color: #FFFFFF;
    border: 1px solid #2A975A;
    padding: 10px 18px;
    font-size: 11pt;
    font-weight: 700;
}

QPushButton[role="primary"]:hover,
QToolButton[role="primary"]:hover,
QPushButton#primarySessionButton:hover {
    background-color: #35B36E;
    border-color: #1E7644;
}

QPushButton[role="primary"]:pressed,
QToolButton[role="primary"]:pressed,
QPushButton#primarySessionButton:pressed {
    background-color: #1E7644;
    border-color: #165C34;
}

QPushButton[role="secondary"],
QToolButton[role="secondary"],
QPushButton#secondarySessionButton {
    background-color: #F3ECDD;
    border-color: #CFBE9E;
    font-weight: 700;
}

QPushButton[role="secondary"]:hover,
QToolButton[role="secondary"]:hover,
QPushButton#secondarySessionButton:hover {
    background-color: #EADFC8;
    border-color: #B89E73;
}

QPushButton[role="secondary"]:pressed,
QToolButton[role="secondary"]:pressed,
QPushButton#secondarySessionButton:pressed {
    background-color: #DFD0B4;
    border-color: #96754A;
}

QPushButton[role="contextual"],
QToolButton[role="contextual"],
QToolButton#secondaryMenuButton {
    background-color: #F8F1E4;
    border-color: #D4C19E;
    font-weight: 700;
}

QPushButton[role="contextual"]:hover,
QToolButton[role="contextual"]:hover,
QToolButton#secondaryMenuButton:hover {
    background-color: #EFE3CF;
    border-color: #BEA178;
}

QPushButton[role="contextual"]:pressed,
QToolButton[role="contextual"]:pressed,
QToolButton#secondaryMenuButton:pressed {
    background-color: #E3D4B8;
    border-color: #9A7B50;
}

QPushButton[role="ghost"],
QToolButton[role="ghost"],
QPushButton[variant="ghost"] {
    background-color: transparent;
    border-color: transparent;
    color: #0B3B27;
}

QPushButton[role="ghost"]:hover,
QToolButton[role="ghost"]:hover,
QPushButton[variant="ghost"]:hover {
    background-color: #EFE6D5;
    border-color: #DCCFB8;
}

QPushButton[role="ghost"]:pressed,
QToolButton[role="ghost"]:pressed,
QPushButton[variant="ghost"]:pressed {
    background-color: #E4D8C1;
    border-color: #C7B391;
}

QPushButton[role="danger"],
QToolButton[role="danger"] {
    background-color: #FFF1EF;
    color: #872F25;
    border-color: #D99A90;
    font-weight: 700;
}

QPushButton[role="danger"]:hover,
QToolButton[role="danger"]:hover {
    background-color: #FFE7E4;
    border-color: #CB786D;
}

QPushButton[role="danger"]:pressed,
QToolButton[role="danger"]:pressed {
    background-color: #FBD8D3;
    border-color: #B95D52;
}

QToolButton#secondaryMenuButton {
    min-width: 88px;
    padding: 9px 18px;
    border-radius: 14px;
}

QToolButton#secondaryMenuButton::menu-indicator {
    image: none;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 12px;
    width: 0px;
}

QComboBox,
QLineEdit,
QSpinBox {
    background-color: #FFFDFC;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    border-radius: 10px;
    padding: 6px 10px;
}

QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover {
    border-color: #2FAC66;
}

QComboBox QAbstractItemView {
    background-color: #FFFDFC;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    selection-background-color: #2FAC66;
    selection-color: #FFFFFF;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    background-color: #F3EBDD;
    border: 1px solid #DCCFB8;
    width: 18px;
    border-radius: 8px;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    margin-right: 4px;
    margin-top: 4px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    margin-right: 4px;
    margin-bottom: 4px;
}

QTextEdit,
QPlainTextEdit,
QListWidget,
QTreeWidget,
QTableWidget,
QTableView {
    background-color: #FFFDFC;
    color: #0B3B27;
    border: 1px solid #E1D5C2;
    border-radius: 12px;
    alternate-background-color: #F8F4EC;
    gridline-color: #E7DECF;
    selection-background-color: #D8EFE0;
    selection-color: #0B3B27;
}

QDialogButtonBox QPushButton {
    min-width: 96px;
}

QHeaderView::section {
    background-color: #F3EBDD;
    color: #0B3B27;
    border: none;
    border-bottom: 1px solid #E1D5C2;
    padding: 8px 10px;
    font-weight: 700;
}

QCheckBox,
QRadioButton {
    color: #0B3B27;
    spacing: 8px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 1px solid #C9B89A;
    background-color: #FFFDFC;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background-color: #2FAC66;
    border-color: #248A53;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: #2FAC66;
}

QTabWidget::pane {
    background-color: #FFFDFC;
    border: 1px solid #E1D5C2;
    border-radius: 16px;
    top: -1px;
    margin-top: 8px;
}

QTabBar::tab {
    background-color: #EFE6D5;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    border-bottom: none;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    min-height: 18px;
    padding: 9px 16px;
    margin-right: 6px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #FFFDFC;
    border-color: #D5C7B1;
    margin-bottom: -1px;
}

QTabBar::tab:hover:!selected {
    background-color: #F5EDDF;
}

QTabBar::tab:!selected {
    margin-top: 4px;
}

QMenuBar {
    background-color: #FBF8F2;
    color: #0B3B27;
    border-bottom: 1px solid #E1D5C2;
    padding: 4px 8px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background-color: #EFE6D5;
}

QMenu {
    background-color: #FFFDFC;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    padding: 6px;
}

QMenu::separator {
    height: 1px;
    background-color: #E7DECF;
    margin: 6px 10px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #2FAC66;
    color: #FFFFFF;
}

QStatusBar {
    background-color: #FBF8F2;
    color: #4F6259;
    border-top: 1px solid #E1D5C2;
    padding: 4px 10px;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QWidget#nodesContextBar {
    background-color: #FFFDF8;
    border: 1px solid #DCCFB8;
    border-radius: 12px;
}

QWidget#nodesContextBar QLabel {
    color: #325245;
    padding: 8px 10px;
}

QWidget#navigationPanel {
    background-color: #EEF5EF;
    border-right: 1px solid #E1D5C2;
}

QWidget#navigationPanel QLabel {
    color: #0B3B27;
}

QWidget#navigationPanel QPushButton {
    text-align: left;
    background-color: transparent;
    color: #0B3B27;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 10px 12px;
    font-weight: 700;
}

QWidget#navigationPanel QPushButton:hover {
    background-color: #E2ECE4;
    border-color: #C3D4C7;
}

QWidget#navigationPanel QPushButton:checked {
    background-color: #F7FBF7;
    color: #0B3B27;
    border-color: #C8D8CC;
    border-left: 3px solid #2FAC66;
    padding-left: 10px;
}

QWidget#homeMapPanel {
    background-color: transparent;
}

QLabel#controlPlaneStatusLabel {
    font-weight: 600;
}

QLabel#controlPlaneResolutionMessage[emphasis="true"] {
    font-weight: 700;
    color: #7A4D0E;
}

QTextEdit#monoLogView,
QPlainTextEdit#monoLogView {
    font-family: Consolas, "Courier New", monospace;
    font-size: 9.5pt;
}

QFrame#toastNotification {
    border-radius: 16px;
}

QFrame#toastNotification[level="info"] {
    background-color: #FFFDF9;
    border: 1px solid #DCCFB8;
}

QFrame#toastNotification[level="success"] {
    background-color: #EFF8F1;
    border: 1px solid #ACD8BA;
}

QFrame#toastNotification[level="warning"] {
    background-color: #FFF6EA;
    border: 1px solid #E0C187;
}

QFrame#toastNotification[level="error"] {
    background-color: #FFF1EF;
    border: 1px solid #D9978B;
}

QFrame#toastAccent {
    border-radius: 2px;
}

QFrame#toastAccent[level="info"] {
    background-color: #DCCFB8;
}

QFrame#toastAccent[level="success"] {
    background-color: #79C195;
}

QFrame#toastAccent[level="warning"] {
    background-color: #D8A64D;
}

QFrame#toastAccent[level="error"] {
    background-color: #CD6A5D;
}

QLabel#toastTitle {
    background: transparent;
    font-weight: 700;
    font-size: 10pt;
}

QLabel#toastMessage {
    background: transparent;
}

QFrame#toastNotification[level="info"] QLabel#toastTitle {
    color: #0B3B27;
}

QFrame#toastNotification[level="success"] QLabel#toastTitle {
    color: #0B3B27;
}

QFrame#toastNotification[level="warning"] QLabel#toastTitle {
    color: #432918;
}

QFrame#toastNotification[level="error"] QLabel#toastTitle {
    color: #7B2C20;
}

QFrame#toastNotification[level="info"] QLabel#toastMessage {
    color: #4F6259;
}

QFrame#toastNotification[level="success"] QLabel#toastMessage {
    color: #3F5E51;
}

QFrame#toastNotification[level="warning"] QLabel#toastMessage {
    color: #6A5139;
}

QFrame#toastNotification[level="error"] QLabel#toastMessage {
    color: #7B2C20;
}
