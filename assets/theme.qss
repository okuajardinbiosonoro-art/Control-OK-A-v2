/*
 * Control OKÚA v2
 * Base visual clara y corporativa para la GUI desktop.
 */

QMainWindow,
QDialog {
    background-color: #F7F4EC;
}

QWidget {
    background-color: transparent;
    color: #0B3B27;
    font-family: "Segoe UI", "Roboto", sans-serif;
    font-size: 10pt;
}

QWidget#shellContentHost,
QWidget#homeOperationContent,
QDialog#sessionDetailsDialog,
QWidget#sessionDetailsTab,
QWidget#sessionDetailsContent,
QWidget#sessionDetailsViewport {
    background-color: #F7F4EC;
}

QToolTip {
    background-color: #FFFDF9;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    padding: 6px 8px;
}

QLabel {
    background-color: transparent;
    color: #0B3B27;
    padding: 0;
}

QLabel#shellTitleLabel {
    color: #0B3B27;
    font-weight: 700;
}

QLabel#shellSubtitleLabel {
    color: #5B6F66;
}

QLabel#homeStatusChip {
    background-color: #E9F5EE;
    color: #0B3B27;
    border: 1px solid #C9DCCF;
    border-radius: 14px;
    padding: 6px 12px;
    font-weight: 700;
}

QLabel#homeStatusLine {
    color: #0B3B27;
    font-size: 16px;
    font-weight: 600;
}

QLabel#homeMetaLabel {
    color: #5A695F;
}

QLabel#dialogHeadlineLabel {
    color: #0B3B27;
    font-size: 15px;
    font-weight: 700;
}

QLabel#dialogSubtleLabel {
    color: #5B6F66;
}

QGroupBox {
    background-color: #FFFDFC;
    border: 1px solid #E1D5C2;
    border-radius: 14px;
    margin-top: 14px;
    padding: 12px 14px 14px 14px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 6px;
    color: #0B3B27;
    background-color: #FFFDFC;
    font-weight: 700;
}

QPushButton,
QToolButton {
    background-color: #FFFDF9;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    border-radius: 12px;
    padding: 9px 14px;
    font-weight: 600;
}

QPushButton:hover,
QToolButton:hover {
    background-color: #F3EBDD;
    border-color: #CBBBA0;
}

QPushButton:pressed,
QToolButton:pressed {
    background-color: #E8DDCB;
    border-color: #BFA883;
}

QPushButton:disabled,
QToolButton:disabled {
    background-color: #E7E5DF;
    color: #95A39B;
    border-color: #D8D4CA;
}

QPushButton:focus,
QToolButton:focus,
QComboBox:focus,
QSpinBox:focus,
QTextEdit:focus,
QTreeWidget:focus,
QTableWidget:focus {
    border: 2px solid #2FAC66;
}

QPushButton#primarySessionButton {
    background-color: #2FAC66;
    color: #FFFFFF;
    border: 1px solid #2A975A;
    padding: 10px 18px;
    font-size: 11pt;
    font-weight: 700;
}

QPushButton#primarySessionButton:hover {
    background-color: #35B36E;
    border-color: #1E7644;
}

QPushButton#primarySessionButton:pressed {
    background-color: #1E7644;
    border-color: #165C34;
}

QPushButton#primarySessionButton:focus {
    border: 2px solid #0B3B27;
    padding: 9px 17px;
}

QToolButton#secondaryMenuButton {
    min-width: 88px;
    padding: 9px 18px;
    background-color: #F3ECDD;
    border-color: #CFBE9E;
    font-weight: 700;
    border-radius: 14px;
}

QToolButton#secondaryMenuButton:hover {
    background-color: #EADFC8;
    border-color: #B89E73;
}

QToolButton#secondaryMenuButton:pressed {
    background-color: #DFD0B4;
    border-color: #96754A;
}

QToolButton#secondaryMenuButton:focus {
    border: 2px solid #0B3B27;
    padding: 8px 17px;
}

QToolButton#secondaryMenuButton::menu-indicator {
    image: none;
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 12px;
    width: 0px;
}

QPushButton[variant="ghost"] {
    background-color: transparent;
    border-color: transparent;
    color: #0B3B27;
}

QPushButton[variant="ghost"]:hover {
    background-color: #EFE6D5;
    border-color: #DCCFB8;
}

QPushButton[variant="ghost"]:pressed {
    background-color: #E4D8C1;
    border-color: #C7B391;
}

QComboBox,
QLineEdit,
QSpinBox {
    background-color: #FFFDFC;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    border-radius: 10px;
    padding: 6px 10px;
}

QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover {
    border-color: #2FAC66;
}

QComboBox QAbstractItemView {
    background-color: #FFFDFC;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    selection-background-color: #2FAC66;
    selection-color: #FFFFFF;
}

QSpinBox::up-button,
QSpinBox::down-button {
    subcontrol-origin: border;
    background-color: #F3EBDD;
    border: 1px solid #DCCFB8;
    width: 18px;
    border-radius: 8px;
}

QSpinBox::up-button {
    subcontrol-position: top right;
    margin-right: 4px;
    margin-top: 4px;
}

QSpinBox::down-button {
    subcontrol-position: bottom right;
    margin-right: 4px;
    margin-bottom: 4px;
}

QTextEdit,
QPlainTextEdit,
QListWidget,
QTreeWidget,
QTableWidget {
    background-color: #FFFDFC;
    color: #0B3B27;
    border: 1px solid #E1D5C2;
    border-radius: 12px;
    alternate-background-color: #F8F4EC;
    gridline-color: #E7DECF;
    selection-background-color: #D8EFE0;
    selection-color: #0B3B27;
}

QDialogButtonBox QPushButton {
    min-width: 96px;
}

QHeaderView::section {
    background-color: #F3EBDD;
    color: #0B3B27;
    border: none;
    border-bottom: 1px solid #E1D5C2;
    padding: 8px 10px;
    font-weight: 700;
}

QScrollArea {
    background-color: transparent;
    border: none;
}

QCheckBox {
    color: #0B3B27;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border-radius: 4px;
    border: 1px solid #C9B89A;
    background-color: #FFFDFC;
}

QCheckBox::indicator:checked {
    background-color: #2FAC66;
    border-color: #248A53;
}

QCheckBox::indicator:hover {
    border-color: #2FAC66;
}

QTabWidget::pane {
    border: none;
    background-color: transparent;
}

QTabBar::tab {
    background-color: #EFE6D5;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    border-bottom: none;
    border-top-left-radius: 10px;
    border-top-right-radius: 10px;
    padding: 8px 14px;
    font-weight: 600;
}

QTabBar::tab:selected {
    background-color: #FFFDFC;
}

QMenuBar {
    background-color: #FBF8F2;
    color: #0B3B27;
    border-bottom: 1px solid #E1D5C2;
    padding: 4px 8px;
}

QMenuBar::item {
    background-color: transparent;
    padding: 6px 10px;
    border-radius: 8px;
}

QMenuBar::item:selected {
    background-color: #EFE6D5;
}

QMenu {
    background-color: #FFFDFC;
    color: #0B3B27;
    border: 1px solid #DCCFB8;
    padding: 6px;
}

QMenu::separator {
    height: 1px;
    background-color: #E7DECF;
    margin: 6px 10px;
}

QMenu::item {
    padding: 8px 24px 8px 12px;
    border-radius: 8px;
}

QMenu::item:selected {
    background-color: #2FAC66;
    color: #FFFFFF;
}

QStatusBar {
    background-color: #FBF8F2;
    color: #4F6259;
    border-top: 1px solid #E1D5C2;
    padding: 4px 10px;
}

QWidget#navigationPanel {
    background-color: #EEF5EF;
    border-right: 1px solid #E1D5C2;
}

QWidget#navigationPanel QLabel {
    color: #0B3B27;
}

QWidget#navigationPanel QPushButton {
    text-align: left;
    background-color: transparent;
    color: #0B3B27;
    border: 1px solid transparent;
    border-radius: 12px;
    padding: 10px 12px;
    font-weight: 700;
}

QWidget#navigationPanel QPushButton:hover {
    background-color: #E2ECE4;
    border-color: #C3D4C7;
}

QWidget#navigationPanel QPushButton:checked {
    background-color: #F7FBF7;
    color: #0B3B27;
    border-color: #C8D8CC;
    border-left: 3px solid #2FAC66;
    padding-left: 10px;
}

QWidget#homeMapPanel {
    background-color: transparent;
}
